{
  "name": "badminton-coach",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev": "concurrently -k -n web,api,worker -c cyan,green,magenta \"npm:dev:web\" \"npm:dev:api\" \"npm:dev:worker\"",
    "dev:demo": "DATA_DIR=./data-demo POSE_BACKEND=fake REPORT_PROVIDER=template npm run dev",
    "dev:web": "npm --workspace apps/web run dev",
    "dev:api": "cd apps/api && uv run uvicorn app.main:app --reload --host 127.0.0.1 --port 8000",
    "dev:worker": "cd apps/api && uv run python -m app.worker",
    "build": "npm --workspace apps/web run build",
    "typecheck": "npm --workspace apps/web run typecheck",
    "contracts": "./scripts/generate-contracts.sh",
    "contracts:check": "./scripts/check-contracts.sh",
    "test:api": "cd apps/api && uv run pytest -q",
    "test": "npm run test:api",
    "check": "npm run typecheck && npm run test:api"
  },
  "devDependencies": {
    "concurrently": "^10.0.6",
    "json-schema-to-typescript": "^16.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
