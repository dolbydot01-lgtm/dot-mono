# Web -> API. Next reads NEXT_PUBLIC_* from apps/web/.env.local, not this file.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Storage
DATA_DIR=./data
MAX_UPLOAD_MB=200

# Analysis
ANALYSIS_FPS=15
VIDEO_MAX_WIDTH=1280
POSE_BACKEND=ultralytics
POSE_MODEL=yolo11n-pose.pt
POSE_DEVICE=auto

# Report generation. Use "template" to skip the API entirely.
REPORT_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# The COACH_ prefix avoids colliding with Claude Code's own ANTHROPIC_MODEL.
COACH_ANTHROPIC_MODEL=claude-opus-5-5
COACH_ANTHROPIC_EFFORT=medium
# COACH_ANTHROPIC_MAX_TOKENS=16000
