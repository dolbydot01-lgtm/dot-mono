{
  "name": "web3-course",
  "version": "0.1.0",
  "description": "Web 3.0 理论与实践课程：讲义、实验与习题",
  "scripts": {
    "m0:trace": "node modules/M00-intro/labs/trace-tx.mjs",
    "m1:cpp": "cd modules/M01-cryptography/labs/cpp && c++ -std=c++17 -O2 -Wall main.cpp -o lab1 && ./lab1",
    "m1:js": "cd modules/M01-cryptography/labs/js && for f in 0*.mjs; do echo \"\\n##### $f\"; node $f || exit 1; done",
    "labs": "node scripts/run-all-labs.mjs",
    "labs:online": "node scripts/run-all-labs.mjs --online",
    "links": "node scripts/check-links.mjs",
    "quiz:sync": "node scripts/sync-quiz.mjs",
    "check:modules": "node scripts/check-modules.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:labs": "node scripts/check-lab-commands.mjs",
    "check:placeholders": "node scripts/check-placeholders.mjs",
    "check:quiz": "node scripts/check-quiz.mjs",
    "qa": "npm run check:modules && npm run check:content && npm run check:labs && npm run check:placeholders && npm run links && npm run labs"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "viem": "^2.57.13"
  },
  "private": true,
  "type": "module"
}
